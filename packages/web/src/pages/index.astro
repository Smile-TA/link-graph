---
import { listSites } from "@link-graph/db";
import { pool } from "../db";

const sites = await listSites(pool);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>link-graph</title>
  </head>
  <body>
    <h1>Sites</h1>
    <ul>
      {sites.map((site) => (
        <li>
          <a href={`/sites/${site.siteId}/`}>{site.siteId}</a> — {site.canonicalHost}
        </li>
      ))}
    </ul>
  </body>
</html>
