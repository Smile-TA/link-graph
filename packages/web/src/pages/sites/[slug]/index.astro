---
import "../../../styles/global.css";
import { runReportCommand, UsageError } from "@link-graph/cli";
import { listExternalLinksForCrawl, listPagesPage } from "@link-graph/db";
import ClassLegend from "../../../components/ClassLegend.astro";
import FindingTable from "../../../components/FindingTable.astro";
import Pager from "../../../components/Pager.astro";
import { pool } from "../../../db";
import { brokenEvidence, orphanEvidence } from "../../../render";

const { slug } = Astro.params;
if (slug === undefined) return Astro.redirect("/");

let report;
try {
  report = await runReportCommand(pool, slug);
} catch (error) {
  const status = error instanceof UsageError ? 404 : 409;
  const message = error instanceof Error ? error.message : String(error);
  return new Response(message, { status, headers: { "content-type": "text/plain" } });
}

// 50 rows/page: small enough that even the 7,352-external-link crawl measured
// 2026-09-28 never renders more than that at once, without needing a second
// dependency (tanstack-table's client-side paging is Phase 5's job, for the sites
// list; these two are plain SSR pages with no client interactivity yet).
const PAGE_SIZE = 50;
const extPage = Math.max(1, Number(Astro.url.searchParams.get("extPage") ?? "1") || 1);
const pagesPage = Math.max(1, Number(Astro.url.searchParams.get("pagesPage") ?? "1") || 1);
const crawlId = report.metrics.crawlId;
const [externalLinks, allPages] = await Promise.all([
  listExternalLinksForCrawl(pool, crawlId, PAGE_SIZE, (extPage - 1) * PAGE_SIZE),
  listPagesPage(pool, crawlId, PAGE_SIZE, (pagesPage - 1) * PAGE_SIZE),
]);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{report.siteId} — link-graph</title>
  </head>
  <body>
    <p>
      <a href="/">&larr; sites</a> · <a href={`/sites/${report.siteId}/treemap/`}>treemap</a> ·
      <a href={`/sites/${report.siteId}/distributions/`}>distributions</a> ·
      <a href={`/sites/${report.siteId}/section-matrix/`}>section matrix</a> ·
      <a href={`/sites/${report.siteId}/ego/`}>ego network</a>
    </p>
    <h1>{report.siteId} <small>{report.canonicalHost}</small></h1>
    <p>
      Crawl #{report.metrics.crawlId} — {report.crawl.pages} page(s), {report.crawl.links} link(s)
      {report.crawl.wasThrottled && " — throttled at least once; treat orphans as a ceiling"}
    </p>
    {report.metrics.orphansUnknownReason !== null ? (
      <p>Orphans unknown: {report.metrics.orphansUnknownReason}</p>
    ) : (
      <FindingTable
        title="Orphans"
        findings={report.orphans}
        renderEvidence={orphanEvidence}
        siteId={report.siteId}
        currentUrl={Astro.url}
      />
    )}
    <FindingTable
      title="Broken internal links"
      findings={report.brokenLinks}
      renderEvidence={brokenEvidence}
      siteId={report.siteId}
      currentUrl={Astro.url}
    />

    <section>
      <h2>External links ({externalLinks.total})</h2>
      <Pager
        page={extPage}
        pageSize={PAGE_SIZE}
        total={externalLinks.total}
        pageParam="extPage"
        currentUrl={Astro.url}
      />
      {externalLinks.rows.length === 0 ? (
        <p>(none)</p>
      ) : (
        <table>
          <thead>
            <tr><th>url</th><th>status</th><th>last checked</th><th>note</th></tr>
          </thead>
          <tbody>
            {externalLinks.rows.map((link) => (
              <tr>
                <td>
                  <a
                    href={link.urlNormalized}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${link.urlNormalized}, opens in a new tab`}
                    title="opens in a new tab"
                  >
                    {link.urlNormalized} ↗
                  </a>
                </td>
                <td>{link.lastChecked === null ? "not yet checked" : link.unverified ? "unverified" : (link.statusCode ?? "—")}</td>
                <td>{link.lastChecked === null ? "—" : link.lastChecked.toISOString().slice(0, 16).replace("T", " ")}</td>
                <td>{link.detail ?? ""}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>

    <section>
      <h2>All pages ({allPages.total})</h2>
      <Pager
        page={pagesPage}
        pageSize={PAGE_SIZE}
        total={allPages.total}
        pageParam="pagesPage"
        currentUrl={Astro.url}
      />
      {allPages.rows.length === 0 ? (
        <p>(none)</p>
      ) : (
        <table>
          <thead>
            <tr><th>path</th><th>status</th><th>class</th></tr>
          </thead>
          <tbody>
            {allPages.rows.map((page) => (
              <tr>
                <td>
                  <a href={`/sites/${report.siteId}/ego/?path=${encodeURIComponent(page.urlNormalized)}`}>
                    {page.path}
                  </a>
                  {" "}
                  <a
                    href={page.urlNormalized}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`visit ${page.path}, opens in a new tab`}
                    title="visit the live page (opens in a new tab)"
                  >
                    ↗
                  </a>
                </td>
                <td>{page.statusCode ?? "—"}</td>
                <td>{page.class ?? "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
      <ClassLegend />
    </section>
  </body>
</html>
