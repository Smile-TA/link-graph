---
import { siteBySlug, UsageError } from "@link-graph/cli";
import { findLatestCompleteCrawl, listPages } from "@link-graph/db";
import { pool } from "../../../db";
import { buildTree, layoutIcicle, orphanColor } from "../../../treemap";

const { slug } = Astro.params;
if (slug === undefined) return Astro.redirect("/");

let site;
try {
  site = await siteBySlug(pool, slug);
} catch (error) {
  if (!(error instanceof UsageError)) throw error;
  return new Response(error.message, { status: 404, headers: { "content-type": "text/plain" } });
}

const crawl = await findLatestCompleteCrawl(pool, site.id);
if (crawl === null) {
  return new Response(`no complete crawl of ${site.siteId} yet`, {
    status: 409,
    headers: { "content-type": "text/plain" },
  });
}
const pages = await listPages(pool, crawl.id);
const root = buildTree(pages);
const ROW_HEIGHT = 22;
const WIDTH = 960;
// Deep enough to separate real sections (PRD examples run 2-3 segments deep:
// /inspire/, /about-us/our-partners/), shallow enough that every row is still wide
// enough to label at this page count.
const MAX_DEPTH = 4;
const rects = layoutIcicle(root, WIDTH, MAX_DEPTH).filter((rect) => rect.width >= 1);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{site.siteId} treemap — link-graph</title>
    <style>
      .rect { stroke: #fff; stroke-width: 0.5; }
      .rect text { font: 10px sans-serif; fill: #222; pointer-events: none; }
    </style>
  </head>
  <body>
    <p><a href={`/sites/${site.siteId}/`}>&larr; report</a></p>
    <h1>{site.siteId} <small>{site.canonicalHost}</small> — site shape</h1>
    <p>
      Crawl #{crawl.id}, {pages.length} page(s). Each row is one path depth (down to
      {MAX_DEPTH}); width is how many pages live under that segment, colour is what
      fraction of them are orphans — green none, red all. A row at the depth cutoff
      speaks for every page beneath it, not just its own.
    </p>
    <svg width={WIDTH} height={(Math.max(...rects.map((rect) => rect.depth)) + 1) * ROW_HEIGHT}>
      {rects.map((rect) => (
        <g class="rect" transform={`translate(${rect.x}, ${rect.depth * ROW_HEIGHT})`}>
          <rect width={rect.width} height={ROW_HEIGHT} fill={orphanColor(rect.node)} />
          {rect.width > 30 && (
            <title>
              {rect.node.name} — {rect.node.value} page(s), {rect.node.orphanCount} orphan(s)
            </title>
          )}
          {rect.width > 30 && (
            <text x={4} y={ROW_HEIGHT / 2 + 3}>{rect.node.name} ({rect.node.orphanCount}/{rect.node.value})</text>
          )}
        </g>
      ))}
    </svg>
  </body>
</html>
