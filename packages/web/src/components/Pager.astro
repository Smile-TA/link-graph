---
/**
 * Prev/next over one paginated list, plain links rather than a client component — the
 * whole page is Astro SSR already (docs/notes.md item 11), and a link that changes one
 * query param needs no JavaScript to work. `pageParam` lets two paginated lists share
 * one page (external links, all pages) without one's page number clobbering the
 * other's in the URL.
 */
interface Props {
  readonly page: number;
  readonly pageSize: number;
  readonly total: number;
  readonly pageParam: string;
  readonly currentUrl: URL;
}

const { page, pageSize, total, pageParam, currentUrl } = Astro.props;
const lastPage = Math.max(1, Math.ceil(total / pageSize));

function urlFor(targetPage: number): string {
  const url = new URL(currentUrl);
  url.searchParams.set(pageParam, String(targetPage));
  return `${url.pathname}${url.search}`;
}
---
<p>
  page {page} of {lastPage} ({total} total)
  {page > 1 && <> · <a href={urlFor(page - 1)}>&larr; prev</a></>}
  {page < lastPage && <> · <a href={urlFor(page + 1)}>next &rarr;</a></>}
</p>
