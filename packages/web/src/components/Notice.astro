---
const { site, description = 'Crawl evidence is read-only; review judgements are saved to the shared database.' } = Astro.props;
---
<div class="notice" role="note">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
  <span><strong>Local PostgreSQL data.</strong> {description}{site?.orphanUnknownReason && ` Orphan total is unknown: ${site.orphanUnknownReason.replaceAll('_', ' ')}.`}</span>
</div>
