---
/**
 * docs/notes.md item 12: "Class" is PRD §2's own taxonomy term (`PAGE_CLASSES`,
 * `packages/db/src/repo/pages.ts`) and accurate, just unexplained out of context — kept
 * rather than renamed (a friendlier header would be less precise than the vocabulary
 * the rest of the codebase already uses), with an inline legend instead, the same
 * on-page-rather-than-linked-elsewhere call item 8 made.
 */
import type { PageClass } from "@link-graph/db";

// `satisfies`, not a plain object, so a class PAGE_CLASSES gains tomorrow fails here at
// compile time rather than rendering a legend silently missing one row.
const DEFINITIONS = {
  linked: "something other than the nav or footer links here — the ordinary case",
  orphan: "in the truth source, includable, and nothing links here at all",
  excluded:
    "not part of the orphan question: noindex, a canonical elsewhere, a redirect, an ignored path, or not content at all (a taxonomy/author archive, a page-builder artifact)",
  not_in_truth_source: "crawled, but the inventory does not list it, so the question does not apply",
  undetectable:
    "the orphan question cannot be answered for this page — no truth source, or a sampled crawl",
} satisfies Record<PageClass, string>;
---
<details>
  <summary>what "class" means</summary>
  <dl>
    {Object.entries(DEFINITIONS).map(([name, meaning]) => (
      <>
        <dt><code>{name}</code></dt>
        <dd>{meaning}</dd>
      </>
    ))}
  </dl>
</details>
