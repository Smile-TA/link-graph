# Local development template. Copy to .env — that one is gitignored, this one is
# committed on purpose (see .gitignore).
#
#   cp .env.example .env && docker compose up -d --wait
#
# DATABASE_URL is the only variable this project reads. Nothing loads this file
# automatically: export it, or run node with `--env-file=.env`. Measured: vitest does
# not load it either — Vite only copies variables matching its `envPrefix` (default
# `VITE_`) into process.env.
#
# When DATABASE_URL is unset, packages/db falls back to exactly the value below, so
# an unmodified checkout works against `docker compose up -d --wait` with no .env at
# all. The credentials are the local container's, hardcoded in docker-compose.yml and
# not a secret. A deployment sets this to something else.
DATABASE_URL=postgres://link_graph:link_graph@localhost:5432/link_graph

# Where the lychee binary is (PRD §6.1, step 8). Unset is fine: packages/linkcheck falls
# back to vendor/lychee/lychee, which `scripts/fetch-lychee.sh` installs. Set this when
# the binary lives elsewhere — the worker image, or a system package. A missing binary is
# a refusal, never a run that checks nothing.
# LYCHEE_BIN=/usr/local/bin/lychee
