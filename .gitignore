# --- dependencies ---
node_modules/
.pnp
.pnp.js

# --- build output ---
dist/
build/
*.tsbuildinfo

# --- test & coverage ---
coverage/
.nyc_output/

# --- Playwright (opt-in crawler mode, PRD §5) ---
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# --- Astro (web service) ---
.astro/

# --- lychee (external link checker, PRD §6.1) ---
# our external_urls table is the source of truth, not this cache
.lycheecache
# The lychee binary itself. 17.9 MB of third-party Mach-O/ELF, fetched by
# scripts/fetch-lychee.sh against the release's published sha256 — a multi-megabyte
# executable committed here would be effectively irreversible, and PRD §8 vendors it
# into the worker image rather than into the repository.
vendor/

# --- local Postgres volume (docker compose) ---
.data/
pgdata/

# --- secrets ---
# .env.example IS committed as the documented template
.env
.env.*
!.env.example

# --- logs ---
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- agent session state ---
# loop/scheduler bookkeeping, not project content
.claude/scheduled_tasks.lock

# --- local scratch ---
scratch/
tmp/
*.local

# --- editors ---
.vscode/
.idea/
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# NOTE: docs/census.json is deliberately NOT ignored — it is measured estate data
# referenced throughout the PRD, and is documentation rather than build output.
