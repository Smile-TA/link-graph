{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // `packages/web` is the Astro app (JSX, `.astro` pages, the vendored Link Graph pack UI,
  // browser globals): `astro check` type-checks it against its own tsconfig, which is what
  // `npm run lint` runs for it.
  "exclude": ["packages/web"],
  "include": [
    "packages/*/src/**/*.ts",
    "eslint.config.mjs",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}
